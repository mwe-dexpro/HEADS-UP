{
  "name": "heads-up",
  "version": "1.3.1",
  "private": true,
  "description": "Lead-time reminders for calendar events.",
  "type": "module",
  "scripts": {
    "dev": "node build.mjs --serve",
    "build": "node build.mjs",
    "preview": "node build.mjs && npx --yes serve dist -l 8000",
    "format": "prettier --write \"src/**/*.jsx\" \"web/**/*.{js,jsx,html}\" \"*.{json,md}\" \"build.mjs\" \"tools/*.mjs\"",
    "check": "prettier --check \"src/**/*.jsx\" \"web/**/*.{js,jsx}\" \"build.mjs\" \"tools/*.mjs\" && node build.mjs",
    "icons": "node tools/make-icons.mjs",
    "android": "npm run build && cap sync android && cap open android",
    "android:apk": "npm run build && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.8",
    "@capacitor/local-notifications": "^7.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/cli": "^7.6.8",
    "esbuild": "^0.25.0",
    "prettier": "^3.8.1"
  }
}
