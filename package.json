{
  "name": "heads-up",
  "version": "1.2.0",
  "private": true,
  "description": "Lead-time reminders for calendar events.",
  "type": "module",
  "scripts": {
    "dev": "node build.mjs --serve",
    "build": "node build.mjs",
    "preview": "node build.mjs && npx --yes serve dist -l 8000",
    "format": "prettier --write \"src/**/*.jsx\" \"web/**/*.{js,jsx,html}\" \"*.{json,md}\" \"build.mjs\"",
    "check": "prettier --check \"src/**/*.jsx\" \"web/**/*.{js,jsx}\" \"build.mjs\" && node build.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "prettier": "^3.8.1"
  }
}
